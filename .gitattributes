# Normalise line endings so contributors on Linux and macOS do not produce
# whole-file diffs against work done on Windows.
* text=auto eol=lf

# Windows-only tooling that must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files git must never try to normalise.
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.dll  binary
*.snk  binary

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "MaxRequestBytes": 16777216,
    "RenderTimeoutMilliseconds": 15000
  },
  "Rendering": {
    "MaxTemplateBytes": 5242880,
    "MaxImageBytes": 2097152,
    "MaxFieldCount": 100,
    "MaxTextLength": 4096,
    "MaxPages": 10,
    "DefaultFontFamily": "Arial",
    "DefaultFontSizePoints": 10,
    "MinimumFontSizePoints": 5,
    "FontDirectory": ""
  }
}
